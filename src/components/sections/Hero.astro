---
import ExternalLink from "../ui/ExternalLink.astro";
import { site } from "../../data/site";
import type { Locale } from "../../i18n/ui";
import { defaultLocale, ui } from "../../i18n/ui";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const year = new Date().getFullYear();
const content = ui[locale].hero;
---

<section class:list={["hero", locale === "pt-BR" && "hero--pt"]} aria-labelledby="hero-title">
  <div class="hero__grid editorial-grid container-wide">
    <div class="hero__top">
      <p class="hero__index">{content.index}<span class="hero__index-year"> / {year}</span></p>
      <p class="hero__availability">
        <span class="hero__status-dot" aria-hidden="true"></span>
        <span>{content.statusLabel}<span aria-hidden="true">:</span></span>
        <span class="hero__status-value">{content.statusValue}</span>
      </p>
    </div>

    <div class="hero__headline-block">
      <h1 id="hero-title" class="hero__headline">
        <span class="hero__name">{site.name}</span>
        <span class="hero__display">
          <span>{content.headline[0]}</span>
          <span>{content.headline[1]}<span class="hero__accent" aria-hidden="true">.</span></span>
        </span>
      </h1>
    </div>

    <div class="hero__support">
      <div class="hero__identity">
        <span class="hero__portrait">
          <img
            class="hero__avatar"
            src={site.avatarUrl}
            alt={content.avatarAlt}
            width="88"
            height="88"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </span>
        <div class="hero__identity-copy">
          <p>{content.profileRole}</p>
          <p>{content.profileMeta}</p>
        </div>
      </div>

      <p class="hero__description">{content.description}</p>

      <ol class="hero__expertise" aria-label={content.expertiseLabel}>
        {content.expertise.map((item, index) => (
          <li><span class="hero__expertise-index">{String(index + 1).padStart(2, "0")}</span><span>{item}</span></li>
        ))}
      </ol>
    </div>

    <div class="hero__bottom">
      <div class="hero__actions" aria-label={content.actionsLabel}>
        <a class="hero__action hero__action--primary" href="#work">
          {content.explore} <span aria-hidden="true">↓</span>
        </a>
        <ExternalLink href={site.githubUrl} class="hero__action" {locale}>
          GitHub <span aria-hidden="true">↗</span>
        </ExternalLink>
      </div>

      <div class="hero__location" aria-label={`${content.basedIn} ${content.location}, ${year}`}>
        <span>{year}</span>
        <span>{content.location}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: min(56rem, calc(100svh - var(--header-height)));
    overflow: hidden;
  }

  .hero__grid {
    min-height: inherit;
    padding-block: clamp(2.75rem, 6vw, 5.5rem) clamp(2rem, 4vw, 3.5rem);
    grid-template-rows: auto 1fr auto;
  }

  .hero__top {
    display: flex;
    grid-row: 1;
    grid-column: 1 / -1;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .hero__index,
  .hero__availability,
  .hero__location,
  .hero__expertise {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .hero__index {
    color: var(--color-text-muted);
  }

  .hero__availability {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }

  .hero__status-value {
    color: var(--color-accent-bright);
  }

  .hero__status-dot {
    width: 0.25rem;
    height: 0.25rem;
    flex: 0 0 auto;
    border-radius: var(--radius-pill);
    background: var(--color-accent-bright);
  }

  .hero__headline-block {
    z-index: 1;
    grid-row: 2;
    grid-column: 1 / 9;
    align-self: center;
    padding-block: clamp(3rem, 8vh, 6rem);
  }

  .hero__headline {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: "opsz" 72, "SOFT" 22, "WONK" 0.1;
    font-weight: 620;
  }

  .hero__name {
    display: block;
    margin-bottom: clamp(1rem, 2.5vw, 2rem);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1vw, 0.875rem);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero__display {
    display: block;
    font-size: clamp(5rem, 9.45vw, 8.85rem);
    letter-spacing: -0.047em;
    line-height: 0.8;
    text-transform: uppercase;
    text-wrap: nowrap;
  }

  .hero__display > span {
    display: block;
  }

  .hero--pt .hero__display {
    font-size: clamp(4.75rem, 8.65vw, 8rem);
  }

  .hero__accent {
    color: var(--color-accent-bright);
  }

  .hero__support {
    display: flex;
    grid-row: 2;
    grid-column: 9 / 13;
    align-self: end;
    flex-direction: column;
    gap: var(--space-6);
    padding-bottom: clamp(3rem, 8vh, 6rem);
  }

  .hero__identity {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .hero__portrait {
    position: relative;
    display: block;
    width: 5.25rem;
    height: 5.25rem;
    flex: 0 0 auto;
    overflow: hidden;
    border: 1px solid rgb(var(--color-accent-rgb) / 28%);
    border-radius: 50%;
  }

  .hero__portrait::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgb(var(--color-accent-rgb) / 16%);
    content: "";
    mix-blend-mode: color;
    pointer-events: none;
  }

  .hero__avatar {
    width: 100%;
    height: 100%;
    filter: grayscale(0.88) contrast(1.06);
    object-fit: cover;
  }

  .hero__identity-copy {
    display: grid;
    gap: var(--space-1);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero__identity-copy p:first-child {
    color: var(--color-accent-bright);
    font-weight: 600;
    text-transform: lowercase;
  }

  .hero__description {
    max-width: 31rem;
    color: var(--color-text-secondary);
    font-size: var(--text-body-large);
    line-height: 1.55;
  }

  .hero__expertise {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: var(--space-2) var(--space-5);
    color: var(--color-text-muted);
    list-style: none;
  }

  .hero__expertise li {
    display: grid;
    grid-template-columns: 1.5rem max-content;
    align-items: center;
    gap: var(--space-2);
  }

  .hero__expertise-index {
    color: var(--color-accent-bright);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
  }

  .hero__bottom {
    display: flex;
    grid-row: 3;
    grid-column: 1 / -1;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-subtle);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
  }

  .hero__action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    font-weight: 650;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .hero__action:hover {
    color: var(--color-text-primary);
  }

  .hero__action--primary {
    border-bottom: 1px solid var(--color-accent);
    color: var(--color-text-primary);
  }

  .hero__action--primary:hover {
    border-color: var(--color-accent-bright);
    color: var(--color-accent-bright);
  }

  .hero__location {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    color: var(--color-text-muted);
  }

  @media (max-width: 64rem) {
    .hero__headline-block {
      grid-column: 1 / 10;
    }

    .hero__support {
      grid-column: 9 / 13;
    }

    .hero__display {
      font-size: clamp(4.75rem, 9.7vw, 6.4rem);
    }

    .hero__portrait {
      width: 4.5rem;
      height: 4.5rem;
    }
  }

  @media (min-width: 48.0625rem) and (max-width: 55rem) {
    .hero--pt .hero__grid {
      grid-template-rows: auto auto 1fr auto;
    }

    .hero--pt .hero__headline-block {
      grid-row: 2;
      grid-column: 1 / -1;
      align-self: end;
      padding-block: clamp(2.75rem, 7vh, 4.5rem) var(--space-6);
    }

    .hero--pt .hero__display {
      font-size: clamp(4.75rem, 10.8vw, 5.8rem);
    }

    .hero--pt .hero__support {
      grid-row: 3;
      grid-column: 4 / -1;
      align-self: start;
      padding-bottom: clamp(3rem, 7vh, 4.5rem);
    }

    .hero--pt .hero__bottom {
      grid-row: 4;
    }
  }

  @media (max-width: 48rem) {
    .hero {
      min-height: calc(100svh - var(--header-height));
    }

    .hero__grid {
      padding-block: clamp(2.25rem, 7vw, 4rem) var(--space-6);
      grid-template-rows: auto auto 1fr auto;
    }

    .hero__headline-block {
      grid-row: 2;
      grid-column: 1 / -1;
      align-self: end;
      padding-block: clamp(3.5rem, 10vh, 6rem) var(--space-6);
    }

    .hero__display {
      font-size: clamp(4rem, 16.8vw, 6.4rem);
    }

    .hero--pt .hero__display {
      font-size: clamp(4rem, 13vw, 6.2rem);
    }

    .hero__support {
      grid-row: 3;
      grid-column: 2 / -1;
      align-self: start;
      gap: var(--space-5);
      padding-bottom: clamp(3rem, 8vh, 5rem);
    }

    .hero__description {
      max-width: 35rem;
    }

    .hero__bottom {
      grid-row: 4;
    }
  }

  @media (max-width: 35rem) {
    .hero__index-year {
      display: none;
    }

    .hero__top {
      align-items: flex-start;
    }

    .hero__availability {
      max-width: 10rem;
      justify-content: flex-end;
      text-align: right;
    }

    .hero__headline-block {
      padding-block: clamp(3rem, 9vh, 5rem) var(--space-6);
    }

    .hero__display {
      font-size: clamp(3.65rem, 16.4vw, 5rem);
      letter-spacing: -0.065em;
    }

    .hero__support {
      display: grid;
      grid-template-columns: 3.75rem 1fr;
      grid-column: 1 / -1;
      gap: var(--space-4);
    }

    .hero__identity {
      display: contents;
    }

    .hero__portrait {
      width: 3.75rem;
      height: 3.75rem;
      grid-row: 1;
      grid-column: 1;
    }

    .hero__identity-copy {
      display: none;
    }

    .hero__description {
      grid-row: 1;
      grid-column: 2;
    }

    .hero__expertise {
      grid-row: 2;
      grid-column: 2;
    }

    .hero--pt .hero__display {
      font-size: clamp(2.85rem, 12.4vw, 4rem);
      letter-spacing: -0.055em;
    }

    .hero__bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-4);
    }

    .hero__actions {
      width: 100%;
      justify-content: space-between;
      gap: var(--space-4);
    }

    .hero__location {
      display: none;
    }
  }
</style>
