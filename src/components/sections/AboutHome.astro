---
import type { Locale } from "../../i18n/ui";
import { ui } from "../../i18n/ui";
import { getLocalizedPath } from "../../i18n/utils";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const content = ui[locale].home.about;
---

<section id="about" class="about-home section-space" aria-labelledby="about-home-title">
  <div class="container-wide">
    <SectionHeading
      number={content.number}
      eyebrow={content.eyebrow}
      title={content.title}
      headingId="about-home-title"
    />

    <div class="about-home__content editorial-grid">
      <p class="about-home__annotation">{content.annotation}</p>
      <div class="about-home__copy">
        {content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <a class="about-home__command" href={getLocalizedPath("/about/", locale)} aria-label={content.commandLabel}>
        <span aria-hidden="true">$</span> {content.command} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .about-home {
    border-top: 1px solid var(--color-border-subtle);
  }

  .about-home__content {
    align-items: start;
    margin-top: clamp(3.5rem, 8vw, 7rem);
  }

  .about-home__annotation,
  .about-home__command {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .about-home__annotation {
    grid-column: 1 / 4;
    color: var(--color-text-muted);
  }

  .about-home__copy {
    display: grid;
    grid-column: 4 / 10;
    gap: var(--space-6);
    color: var(--color-text-primary);
    font-size: clamp(1.35rem, 2.6vw, 2.25rem);
    letter-spacing: -0.025em;
    line-height: 1.35;
  }

  .about-home__copy p:last-child {
    color: var(--color-text-secondary);
  }

  .about-home__command {
    grid-column: 10 / 13;
    color: var(--color-accent-bright);
    text-decoration: none;
  }

  .about-home__command:hover {
    color: var(--color-text-primary);
  }

  @media (max-width: 48rem) {
    .about-home__annotation,
    .about-home__copy,
    .about-home__command {
      grid-column: 1 / -1;
    }

    .about-home__copy {
      margin-top: var(--space-6);
    }

    .about-home__command {
      margin-top: var(--space-6);
    }
  }
</style>
