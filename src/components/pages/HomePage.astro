---
import DefaultLayout from "../../layouts/DefaultLayout.astro";
import type { Locale } from "../../i18n/ui";
import Hero from "../sections/Hero.astro";
import AboutHome from "../sections/AboutHome.astro";
import ContactHome from "../sections/ContactHome.astro";
import EngineeringData from "../sections/EngineeringData.astro";
import ExperienceHome from "../sections/ExperienceHome.astro";
import SelectedWork from "../sections/SelectedWork.astro";

interface Props { locale: Locale; }
const { locale } = Astro.props;
---

<DefaultLayout {locale}>
  <Hero {locale} />
  <SelectedWork {locale} />
  <AboutHome {locale} />
  <ExperienceHome {locale} />
  <EngineeringData {locale} />
  <ContactHome {locale} />
</DefaultLayout>
